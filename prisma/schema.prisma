// Prisma schema for MySQL datasource
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
}

model Application {
  id           Int      @id @default(autoincrement())
  name         String
  email        String
  dob          DateTime?
  mobileNumber String?
  education    String?
  experience   String?
  address      String?
  position     String?
  resumePath   String?
  createdAt    DateTime @default(now())
}
